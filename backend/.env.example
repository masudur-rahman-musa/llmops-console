# LLMOps Console local config — copy to .env and fill in. NEVER commit .env.
# The `anthropic` provider (backend/config/providers/anthropic.yaml): the first
# choice for every chat alias. Empty or unset drops that provider, and chat then
# answers 503 until a real key is set in `backend/.env`.
ANTHROPIC_API_KEY=
# The `openai` provider (backend/config/providers/openai.yaml): the fallback for
# every chat alias when Anthropic does not answer. Empty or unset drops that
# provider, so chat then runs on Anthropic alone.
OPENAI_API_KEY=
# Azure OpenAI, which ships with no provider file. Both are empty on purpose:
# enabling Azure is setting these two and dropping in the `azure.yaml` file
# `docs/azure.md` shows, and nothing in the code changes with it. The endpoint is the resource root as the portal prints it, with no path on
# it (https://<resource>.openai.azure.com) - there is no vendor default, because
# the endpoint is per-resource. The `model` a request names is the DEPLOYMENT
# name on that resource, not a vendor model id.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
# The api-version every Azure call carries. Unset uses the pinned default; set it
# only for a resource pinned to a different one.
# AZURE_OPENAI_API_VERSION=2024-10-21
# Where traces go: the full OTLP/HTTP traces URL, and its `key=value,key=value`
# auth headers (Langfuse wants a basic-auth header). Both stay commented out to
# send no traces; an empty endpoint is not the same as none.
# OPSCONSOLE_OTLP_ENDPOINT=
# OPSCONSOLE_OTLP_HEADERS=
# What the gateway is called in a trace viewer, so its spans and the help desk's
# can be told apart. Unset uses opsconsole-gateway.
# OPSCONSOLE_OTEL_SERVICE_NAME=opsconsole-gateway
# Which environment this is. Unset means local, which keeps budgets and rate
# limits in memory. Any other value, the empty string included, needs
# OPSCONSOLE_REDIS_URL and OPSCONSOLE_QDRANT_URL or the gateway will not start.
# OPSCONSOLE_ENV=local
# The port the gateway listens on. Unset uses 8080.
# OPSCONSOLE_PORT=8080
# Tenant API keys, as comma-separated `tenant:sha256hex` pairs. Digests only:
# the plaintext key is what a tenant is given, and no tenant's key is stored here
# or anywhere in the repository. Generate a pair with:
#   key=$(python -c 'import secrets; print(secrets.token_urlsafe(32))'); \
#   echo "$key"; echo "acme:$(printf %s "$key" | shasum -a 256 | cut -d" " -f1)"
OPSCONSOLE_API_KEYS=
# The admin key that `/admin/routing` and `/admin/routing/reload` accept, as the
# sha256 digest of the key itself. A separate key space from the tenant keys
# above: a valid tenant key is 401 on `/admin/*`. Empty authorises nobody, which
# is the shipped default. Generate one with:
#   key=$(python -c 'import secrets; print(secrets.token_urlsafe(32))'); \
#   echo "$key"; printf %s "$key" | shasum -a 256 | cut -d" " -f1
OPSCONSOLE_ADMIN_KEY_SHA256=
# The secret an `X-Gateway-Budget-Override` token is signed with, so a tenant that
# has reached its monthly cap can still be served deliberately. A separate secret
# from the admin key above, and the secret itself rather than a digest, because
# verifying an HMAC needs the key. Empty is the shipped default and
# honours no override at all. A token is
# `{YYYY-MM}:{HMAC-SHA256(secret, "tenant:YYYY-MM")}`, so it works for one tenant
# in one month only. Generate the secret with:
#   python -c 'import secrets; print(secrets.token_urlsafe(32))'
# and mint a token with:
#   python -c 'import hashlib,hmac,os,sys; m=sys.argv[2]; \
#     print(m+":"+hmac.new(os.environ["OPSCONSOLE_BUDGET_OVERRIDE_SECRET"].encode(), \
#     f"{sys.argv[1]}:{m}".encode(), hashlib.sha256).hexdigest())' acme 2026-09
OPSCONSOLE_BUDGET_OVERRIDE_SECRET=
# The backing services. Each one is optional: absent means the gateway keeps its
# redaction maps in process memory and `/readyz` does not claim to have checked a
# service nobody configured. Inside `docker compose` these are overridden with
# the service names on that network; the values here are for a gateway running on
# the host against the ports compose publishes.
OPSCONSOLE_REDIS_URL=redis://localhost:16379/0
OPSCONSOLE_DATABASE_URL=postgresql://opsconsole:opsconsole@localhost:15432/opsconsole
OPSCONSOLE_QDRANT_URL=http://localhost:16333
# Where the console's read routes query Prometheus. Empty leaves every metric
# field on /console/* null with `prometheus: unconfigured`. Compose runs one on
# port 9090 and points the gateway at it.
OPSCONSOLE_PROMETHEUS_URL=
# Apply pending ledger migrations when the gateway starts, under an advisory
# lock. Off unless set; compose turns it on. Left commented because
# an empty value is not a true or false.
# OPSCONSOLE_MIGRATE_ON_START=true
# The Langfuse project page the Requests page links each request's trace under
# (<this>/traces/<trace_id>). Empty shows no trace links.
OPSCONSOLE_LANGFUSE_PROJECT_URL=
# Make every trace public in Langfuse, so anyone with a trace's link can read it
# (a tenant opts out with trace_public: false in routing.yaml). Off when unset.
# Commented out because an empty value is not a true or false.
# OPSCONSOLE_PUBLIC_TRACE_LANGFUSE=true
# The Grafana page the Overview tab links for health details. Empty shows no link.
# Locally: http://localhost:3002/d/gateway-overview (the compose grafana service).
OPSCONSOLE_GRAFANA_URL=
# Who a tenant over its monthly budget is told to ask for more, named in the refusal
# message. One email address, or empty to name nobody.
OPSCONSOLE_BUDGET_CONTACT=
# The local Postgres password, used by the database container and by the URL
# above. Local only: the cluster's credential is a SOPS-encrypted secret.
POSTGRES_PASSWORD=opsconsole
# Where the GGUF weights the llama.cpp embedding container serves live, and which
# file it loads. No weights are committed.
MODELS_DIR=./.cache/models
LLAMA_EMBED_MODEL_FILE=bge-small-en-v1.5-q8_0.gguf
# Where the routing policy is read from. Defaults to the repository's
# routing.yaml; set it when the process does not run from the repository layout.
# OPSCONSOLE_ROUTING_POLICY_PATH=/app/routing.yaml
# Where the provider files (each provider, its models and their prices) are read
# from. Defaults to the repository's backend/config/providers; set it for the
# same reason, when the process does not run from the repository layout.
# OPSCONSOLE_PROVIDERS_DIR=/app/config/providers
# Where the quality page reads the eval gate's thresholds from. Defaults to the
# repository's evals/conversation-baseline.json; set it for the same reason.
# OPSCONSOLE_EVAL_BASELINE_PATH=/app/evals/conversation-baseline.json
# The `evals` tenant API key `ops-eval conversations --gateway-url` (and `calibrate`)
# presents to the gateway for the `judge` and `simulated-person` aliases. Empty is the
# shipped default: without it a run judges nothing and says so once on stderr, and
# `calibrate` stops. A key and not a digest, because the harness is a client here and has
# to present it.
OPSCONSOLE_EVAL_JUDGE_KEY=
