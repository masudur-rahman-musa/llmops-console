# What never enters the shipped image. Mirror of the rule:
# src/ is what runs, tests/ is what checks, dev/ is how we work.

# version control and editor
.git
.gitignore
.gitattributes
.editorconfig
.vscode
.idea
.DS_Store

# secrets and local config (real config is injected at runtime)
.env
.env.*
!.env.example

# the coding agent and its tooling
.claude
CLAUDE.md
.mcp.json

# verification, CI, and dev tooling
tests
project-evals
project-obs
infra
.github
.pre-commit-config.yaml
Makefile

# our working process and documentation
dev-process
docs
README.md
LICENSE

# Language artifacts: the image builds its own, and a host .venv is the wrong
# platform's. `**/` because a bare `node_modules/` matches the context root
# only, which let a local build copy web/node_modules in.
**/__pycache__/
.venv/
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
**/node_modules/
**/.next/
dist/
build/
coverage/

# The console is its own image, built from its own context with its own
# .dockerignore. The gateway image needs none of it.
web

# scripts: keep only if a script must run on the server (migrations, seed)
# scripts

# private working files (never in an image either)
notes.md
his.md
REQUIREMENTS.md
pl
dev-process
dev
switches.md
