# The console login. Both unset means every login is refused.
# CONSOLE_PASSWORD_SHA256 is the lowercase hex SHA-256 of the shared password.
# CONSOLE_SESSION_SECRET signs the session cookie and needs 32 characters or more.
CONSOLE_PASSWORD_SHA256=
CONSOLE_SESSION_SECRET=

# The console pages. Read server-side only; unset means every page
# shows "Console data unavailable (unconfigured)." and the tradeoff table
# shows "Not measured yet."
CONSOLE_API_URL=
CONSOLE_ADMIN_KEY=
CONSOLE_TRADEOFF_PATH=
