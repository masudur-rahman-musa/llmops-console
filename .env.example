# Ops Console local config — copy to .env and fill in. NEVER commit .env.
DATABASE_URL=postgresql+asyncpg://opsconsole:opsconsole@localhost:5432/opsconsole
REDIS_URL=redis://localhost:6379/1
QDRANT_URL=http://localhost:6333
ANTHROPIC_API_KEY=replace-me
# The `openai` provider in routing.yaml. Left EMPTY on purpose: empty or unset
# drops that provider, so a copied .env routes `judge` to its first candidate
# only. Fill it in to give `judge` somewhere to fall when that candidate fails.
OPENAI_API_KEY=
LANGFUSE_PUBLIC_KEY=replace-me
LANGFUSE_SECRET_KEY=replace-me
LANGFUSE_HOST=https://cloud.langfuse.com
ADMIN_API_KEY=replace-me
# Tenant API keys, as comma-separated `tenant:sha256hex` pairs. Digests only:
# the plaintext key is what a tenant is given, and no tenant's key is stored here
# or anywhere in the repository. Generate a pair with:
#   key=$(python -c 'import secrets; print(secrets.token_urlsafe(32))'); \
#   echo "$key"; echo "acme:$(printf %s "$key" | shasum -a 256 | cut -d" " -f1)"
OPSCONSOLE_API_KEYS=
# The admin key that `/admin/routing` and `/admin/routing/reload` accept, as the
# sha256 digest of the key itself. A separate key space from the tenant keys
# above: a valid tenant key is 401 on `/admin/*`. Empty authorises nobody, which
# is the shipped default. Generate one with:
#   key=$(python -c 'import secrets; print(secrets.token_urlsafe(32))'); \
#   echo "$key"; printf %s "$key" | shasum -a 256 | cut -d" " -f1
OPSCONSOLE_ADMIN_KEY_SHA256=
# The backing services. Each one is optional: absent means the gateway keeps its
# redaction maps in process memory and `/readyz` does not claim to have checked a
# service nobody configured. Inside `docker compose` these are overridden with
# the service names on that network; the values here are for a gateway running on
# the host against the ports compose publishes.
OPSCONSOLE_REDIS_URL=redis://localhost:6379/0
OPSCONSOLE_DATABASE_URL=postgresql://opsconsole:opsconsole@localhost:5432/opsconsole
OPSCONSOLE_QDRANT_URL=http://localhost:6333
# The local Postgres password, used by the database container and by the URL
# above. Local only: the cluster's credential is a SOPS-encrypted secret.
POSTGRES_PASSWORD=opsconsole
# Where the GGUF weights the llama.cpp container serves live, and which file to
# load. No weights are committed.
MODELS_DIR=./models
LLAMA_MODEL_FILE=qwen2.5-7b-instruct-q4_k_m.gguf
# Where the routing policy is read from. Defaults to the repository's
# routing.yaml; set it when the process does not run from the repository layout.
# OPSCONSOLE_ROUTING_POLICY_PATH=/app/routing.yaml
GOLDEN_SET=../ai-help-desk-governed-access/project-evals/golden/helpdesk-v1.jsonl
ENV=dev
# AI
# LLM_API_KEY=replace-me
# LANGFUSE_PUBLIC_KEY=replace-me
# LANGFUSE_SECRET_KEY=replace-me
# LANGFUSE_HOST=https://cloud.langfuse.com
