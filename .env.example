# Ops Console local config — copy to .env and fill in. NEVER commit .env.
DATABASE_URL=postgresql+asyncpg://opsconsole:opsconsole@localhost:5432/opsconsole
REDIS_URL=redis://localhost:6379/1
QDRANT_URL=http://localhost:6333
ANTHROPIC_API_KEY=replace-me
LANGFUSE_PUBLIC_KEY=replace-me
LANGFUSE_SECRET_KEY=replace-me
LANGFUSE_HOST=https://cloud.langfuse.com
ADMIN_API_KEY=replace-me
# Tenant API keys, as comma-separated `tenant:sha256hex` pairs. Digests only:
# the plaintext key is what a tenant is given, and no tenant's key is stored here
# or anywhere in the repository. Generate a pair with:
#   key=$(python -c 'import secrets; print(secrets.token_urlsafe(32))'); \
#   echo "$key"; echo "acme:$(printf %s "$key" | shasum -a 256 | cut -d" " -f1)"
OPSCONSOLE_API_KEYS=
# Where the routing policy is read from. Defaults to the repository's
# routing.yaml; set it when the process does not run from the repository layout.
# OPSCONSOLE_ROUTING_POLICY_PATH=/app/routing.yaml
GOLDEN_SET=../ai-help-desk-governed-access/project-evals/golden/helpdesk-v1.jsonl
ENV=dev
# AI
# LLM_API_KEY=replace-me
# LANGFUSE_PUBLIC_KEY=replace-me
# LANGFUSE_SECRET_KEY=replace-me
# LANGFUSE_HOST=https://cloud.langfuse.com
