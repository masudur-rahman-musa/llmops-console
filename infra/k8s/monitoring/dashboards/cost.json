{
  "uid": "cost",
  "title": "Cost",
  "description": "Spend, budget consumption and token volume across tenants, providers and models. Provisioned from infra/k8s/monitoring/dashboards/; edits made in the Grafana UI are not saved.",
  "tags": ["cost", "opsconsole"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Spend per second, by tenant, provider and model",
      "description": "Ledger spend booked, split by who is spending it and where it went.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "currencyUSD", "min": 0 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "range": true,
          "legendFormat": "{{tenant}} {{provider}} {{model}}",
          "expr": "sum by (tenant, provider, model) (rate(gateway_cost_usd_total[5m]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Budget consumption ratio, by tenant",
      "description": "Fraction of a tenant's period budget consumed. A tenant reaching 1 is spending its whole allowance.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "range": true,
          "legendFormat": "{{tenant}}",
          "expr": "max by (tenant) (gateway_budget_ratio)"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Tokens per second, by direction",
      "description": "Billed tokens, split by prompt and completion direction, across every tenant, provider and model.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "range": true,
          "legendFormat": "{{direction}}",
          "expr": "sum by (direction) (rate(gateway_tokens_total[5m]))"
        }
      ]
    }
  ]
}
